{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "noImplicitAny": false,
    "paths": {
      "@trikomi/core/studio": ["../trikomi/packages/core/src/studio/index.ts"],
      "@trikomi/core": ["../trikomi/packages/core/src/index.ts"],
      "@trikomi/sportswear": ["../trikomi/packages/sportswear/src/index.ts"]
    }
  },
  "include": ["src"]
}
